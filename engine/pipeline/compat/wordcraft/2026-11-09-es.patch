+#[cfg(test)]
+mod folio_reading_tests {
+    use super::*;
+    #[test]
+    fn reading_blocks_edits_and_undo_without_protecting_the_file() {
+        let mut session = Session::new(Document::new());
+        assert!(session.run("text.insert", &serde_json::json!({"text":"Original"})).is_ok());
+        let original = session.doc.clone();
+        session.view.read_mode = true;
