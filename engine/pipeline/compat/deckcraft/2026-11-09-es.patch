diff --git a/crates/ui-egui/src/folio.rs b/crates/ui-egui/src/folio.rs
new file mode 100644
index 0000000..caebb20
--- /dev/null
+++ b/crates/ui-egui/src/folio.rs
@@ -0,0 +1,49 @@
+//! Folio Android display preference. This never changes the document model.
+#[cfg(target_arch = "wasm32")]
+pub fn dark() -> Option<bool> {
+    js_sys::Reflect::get(&js_sys::global(), &"__folioDark".into()).ok().and_then(|v| v.as_bool())
+}
+#[cfg(not(target_arch = "wasm32"))]
+pub fn dark() -> Option<bool> {
+    None
+}
+
+/// Remap neutral screen paints while preserving coloured content and alpha.
+pub fn color(c: egui::Color32, dark: bool) -> egui::Color32 {
+    if !dark {
+        return c;
+    }
+    let [r, g, b, a] = c.to_srgba_unmultiplied();
+    if r.max(g).max(b).saturating_sub(r.min(g).min(b)) > 20 {
+        return c;
+    }
+    let map = |v: u8| (255u16.saturating_sub(u16::from(v) * 204 / 255)) as u8;
+    egui::Color32::from_rgba_unmultiplied(map(r), map(g), map(b), a)
+}
+
+pub fn image(mut image: egui::ColorImage) -> egui::ColorImage {
+    if dark() == Some(true) {
+        for pixel in &mut image.pixels {
+            *pixel = color(*pixel, true);
+        }
+    }
+    image
+}
+
+include!(concat!(env!("OUT_DIR"), "/folio_fonts.rs"));
+
+/// Replace interface families only. Cell and document font families retain their own data.
+pub fn install_ui_fonts(fonts: &mut egui::FontDefinitions, regular: &str, bold: &str) {
+    if FOLIO_UI_FONTS.is_empty() {
+        return;
+    }
+    for (name, bytes) in FOLIO_UI_FONTS {
+        fonts.font_data.insert((*name).into(), std::sync::Arc::new(egui::FontData::from_static(bytes)));
+    }
+    let mut fallback = fonts.families.get(&egui::FontFamily::Proportional).cloned().unwrap_or_default();
+    fallback.insert(0, "FolioInter".into());
+    fonts.families.insert(egui::FontFamily::Proportional, fallback.clone());
+    fonts.families.insert(egui::FontFamily::Name(regular.into()), fallback.clone());
+    fallback.insert(0, "FolioInterSemiBold".into());
+    fonts.families.insert(egui::FontFamily::Name(bold.into()), fallback);
+}
