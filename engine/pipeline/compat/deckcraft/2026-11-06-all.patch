+// Generate the same pinned UI font input in both language profiles.
+fn lucy_ui_fonts() -> Result<(), Box<dyn std::error::Error>> {
+    println!("cargo::rerun-if-env-changed=FOLIO_UI_FONT_DIR");
+    let mut text = String::from("const FOLIO_UI_FONTS: &[(&str, &[u8])] = &[\n");
+    if let Some(dir) = std::env::var_os("FOLIO_UI_FONT_DIR") {
+        for (name, file) in [("FolioInter", "Inter-Regular.ttf"), ("FolioInterSemiBold", "Inter-SemiBold.ttf")] {
+            let path = std::path::PathBuf::from(&dir).join(file).canonicalize()?;
+            println!("cargo::rerun-if-changed={}", path.display());
+            text.push_str(&format!("({name:?}, include_bytes!({path:?})),\n"));
+        }
+    }
+    text.push_str("];\n");
+    let out = std::path::PathBuf::from(std::env::var("OUT_DIR")?);
+    std::fs::write(out.join("folio_fonts.rs"), text)?;
+    Ok(())
+}
