+                    self.canvas.read_first_visible = None;
+                    let command = if read_only { "view.readMode" } else { "view.printLayout" };
+                    let _ = self.session.run(command, &serde_json::json!({}));
+                }
+                ctx.data_mut(|data| data.insert_temp(key, read_only));
+            }
+            if read_only {
+                use wordcraft_engine::cmd::view::ReadPageColor;
+                self.session.view.read_page_color = if self.session.view.dark_mode { ReadPageColor::Inverse } else { ReadPageColor::None };
+            }
+        }
+
         updates_ui::tick(self, ctx);
         crate::language_packs::tick(self);
         let lang = i18n::Lang::from_pref(&self.ui.language);
